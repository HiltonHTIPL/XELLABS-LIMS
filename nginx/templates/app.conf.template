# Templated by nginx's official envsubst-on-startup mechanism — ${DOMAIN_NAME}
# is filled in from the container's environment at startup, everything else
# ($host, $scheme, etc.) is a normal nginx runtime variable left untouched.

server {
    listen 80;
    server_name ${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # SENAITE's master-data-import Excel uploads need more than nginx's 1m default.
    client_max_body_size 25m;

    # Django admin + its static assets. runserver auto-serves /static/ while
    # DEBUG=True (current QA config), so no separate static file server needed.
    location /static/ {
        proxy_pass http://django:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin {
        proxy_pass http://django:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SENAITE runs on Zope/Plone, which generates absolute URLs/redirects
    # internally. A plain proxy_pass here produces broken links (they'd point
    # at senaite:8080 or drop the /senaite prefix) — Zope's VirtualHostBase
    # convention is required to tell it the real external scheme/host/path.
    location /senaite {
        return 301 /senaite/;
    }
    location /senaite/ {
        proxy_pass http://senaite:8080/VirtualHostBase/https/${DOMAIN_NAME}:443/senaite/VirtualHostRoot/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Next.js frontend — catch-all.
    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
