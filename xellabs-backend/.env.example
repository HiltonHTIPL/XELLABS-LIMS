# Development environment — copy this file to .env
# cp .env.example .env

DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

DB_NAME=xellabs_lims
DB_USER=xellabs_user
DB_PASSWORD=3333
DB_HOST=postgres
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Reference LIMS credentials (internal service — never expose in UI)
SENAITE_URL=http://senaite:8080/senaite
SENAITE_USER=admin
SENAITE_PASSWORD=admin

# Only needed when served through a reverse proxy (e.g. nginx terminating HTTPS
# in front of Django) with DEBUG=False or a domain outside ALLOWED_HOSTS'
# localhost defaults — comma-separated, scheme required. Example for QA:
# ALLOWED_HOSTS=qa.xellabs.com,34.27.190.120
# CSRF_TRUSTED_ORIGINS=https://qa.xellabs.com
