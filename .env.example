# ── Project-root .env for docker-compose ─────────────────────────────────────
# Copy to .env before first `docker compose up -d`:
#   cp .env.example .env          (Git Bash / Linux)
#   Copy-Item .env.example .env   (PowerShell)
# Dev-safe defaults below. Change every value for any real deployment.

# Postgres / Redis (compose services use these; defaults match settings)
DB_PASSWORD=3333
REDIS_PASSWORD=3333

# SENAITE admin login
SENAITE_ADMIN_PASSWORD=admin

# Frontend session encryption — MUST be at least 32 characters or the
# frontend throws "SESSION_SECRET env var must be set..." on login.
SESSION_SECRET=dev-session-secret-change-me-32chars-min!

# Token the frontend uses for server-to-server Django calls
DJANGO_SERVICE_TOKEN=dev-service-token-change-me

# Next.js mode — MUST stay "production" (or be removed).
# NODE_ENV=development breaks `next build` inside the frontend container
# with "Cannot read properties of null (reading 'useContext')".
NODE_ENV=production
